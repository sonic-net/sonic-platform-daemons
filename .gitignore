# debhelper output: the staging trees, the build stamps and the substituted
# variables are all regenerated by `dh`, and each staging tree holds a
# compiled binary.  One per binary package.
debian/.debhelper/
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/*.debhelper.log
debian/Cargo.lock.pinned
debian/sonic-*-rs/
