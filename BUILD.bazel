"""Platform daemons installed directly from their source distributions."""
load("@sonic_build_infra//python:site_packages.bzl", "site_packages")
load("@sonic_build_infra//python:source_package.bzl", "python_runtime_packages")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
package(default_visibility = ["//visibility:public"])
# grpcio-tools passes its package version to this same upstream generator.
cc_binary(
    name = "grpc_python_plugin",
    srcs = ["bazel/grpc_python_plugin.cc"],
    deps = ["@grpc//src/compiler:grpc_plugin_support"],
)
genrule(
    name = "ycabled_proto",
    srcs = ["sonic-ycabled/proto/proto_out/linkmgr_grpc_driver.proto"],
    outs = ["proto_out/linkmgr_grpc_driver_pb2.py", "proto_out/linkmgr_grpc_driver_pb2_grpc.py"],
    tools = ["@protobuf//:protoc", ":grpc_python_plugin"],
    cmd = 'source=$(location sonic-ycabled/proto/proto_out/linkmgr_grpc_driver.proto); include=$${source%/proto_out/*}; $(location @protobuf//:protoc) --plugin=protoc-gen-grpc_python=$(location :grpc_python_plugin) -I"$$include" --python_out=$(RULEDIR) --grpc_python_out=$(RULEDIR) "$$source"',
)

