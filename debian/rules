#!/usr/bin/make -f
# See debhelper(7) (uncomment to enable)
# output every command that modifies files on the build system.
#export DH_VERBOSE = 1

# One binary package per daemon, from one workspace build.  They are one
# source package rather than one each because they share crates/pmon-common
# and the generated facade: building them separately would compile both once
# per daemon, and a deb per daemon is what keeps them independently
# installable and switchable.
#
# Every daemon reaches the platform through platform-provider, which today
# carries only the generated PyO3 bridge onto whatever sonic_platform the image
# installs, so nothing here names a vendor.  A native implementation arrives as
# another arm of platform-provider, through the same SONIC_CARGO_CONFIG [patch]
# described below; neither this file nor any crate's Cargo.toml changes.

%:
	dh $@

# cargo and rustc are deliberately absent from Build-Depends: the slave image
# installs Rust with rustup under /usr/.cargo and puts it on PATH, so there are
# no Debian packages for dpkg-checkbuilddeps to find.  src/sonic-ctrmgrd-rs,
# the other Rust package in this tree, does the same.

# sonic-buildimage builds the daemons against its own sonic-platform-common and
# sonic-swss-common submodules rather than the commits Cargo.lock pins: the
# PyO3 bridge has to match the Python facade the same image installs, and
# swss-common the libswsscommon it links.  It sets SONIC_CARGO_CONFIG to a
# cargo --config file whose [patch] entries point the git dependencies at those
# submodules.  Cargo records a patch in Cargo.lock, so --locked cannot hold with
# one; the committed lock is kept aside and put back by clean.
ifdef SONIC_CARGO_CONFIG
CARGO_ARGS := --config $(SONIC_CARGO_CONFIG)
else
CARGO_ARGS := --locked
endif

override_dh_auto_build:
ifdef SONIC_CARGO_CONFIG
	[ -f debian/Cargo.lock.pinned ] || cp Cargo.lock debian/Cargo.lock.pinned
endif
	cargo build $(CARGO_ARGS) --release --workspace

override_dh_auto_install:
	# do nothing
	:

# Deliberately not `cargo clean`: cargo has to load every workspace member's
# manifest before it will do anything, and removing the directory is what
# `cargo clean` would have done anyway, without needing one.
override_dh_auto_clean:
	rm -rf target
	if [ -f debian/Cargo.lock.pinned ]; then mv debian/Cargo.lock.pinned Cargo.lock; fi

override_dh_auto_test:
	cargo test $(CARGO_ARGS) --release --workspace
