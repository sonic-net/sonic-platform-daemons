# Test-only application root. Production images consume the platform-common
# module directly; they do not acquire a dependency back on sonic-buildimage.
module(name = "sonic_platform_daemons_tests")

bazel_dep(name = "sonic-platform-daemons", version = "1.0.1-49e2a1b497edc8e5678bbd0e46976384d10aed5b", repo_name = "sonic_platform_daemons")
local_path_override(module_name = "sonic-platform-daemons", path = "../..")

# The isolated test application consumes the published platform API owner.
bazel_dep(name = "sonic-platform-common", version = "1.0.1-ccb4645c60863d9949549bb233134150764e98a0", repo_name = "sonic_platform_common")

bazel_dep(name = "sonic-buildimage", version = "0.0.0", repo_name = "sonic_buildimage")
git_override(
    module_name = "sonic-buildimage",
    commit = "c743d7521e80fc1733e5cc0ffc24889b08f78444",
    remote = "https://github.com/securely1g/sonic-buildimage.git",
)

# Preserve the tested image root's explicit overrides, which are not inherited.
single_version_override(
    module_name = "sonic-swss",
    version = "0.0.3-9c3797990d4b5a79100a40fe7689927c18212361",
)

single_version_override(
    module_name = "rules_go",
    version = "0.65.0.sonic.2",
)

single_version_override(
    module_name = "rules_cc",
    version = "0.2.20",
)

single_version_override(
    module_name = "tar.bzl",
    version = "0.10.5.sonic.2",
)

single_version_override(
    module_name = "libnl3",
    version = "3.7.0.sonic.10",
)

single_version_override(
    module_name = "re2",
    version = "2024-07-02.bcr.1",
)

single_version_override(
    module_name = "sonic-build-infra",
    version = "0.0.45-77ef625a4ddafc8cdc15f3cc6aee31eabac8a5de",
)

single_version_override(
    module_name = "sonic-rust-deps",
    version = "0.0.5-5bf69bc0a7d9ea9f4a5606264be592867cd29d1e",
)

bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "patchelf", version = "0.18.0.bcr.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "sonic-build-infra", version = "0.0.45-77ef625a4ddafc8cdc15f3cc6aee31eabac8a5de", repo_name = "sonic_build_infra")
bazel_dep(name = "sonic-swss-common", version = "0.0.9-334389eae54afd1f4f5ee69f89c3a7ad2062ee61", repo_name = "sonic_swss_common")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.13",
)
python.toolchain(python_version = "3.11")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "daemon_tests_pip",
    python_version = "3.13",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "daemon_tests_pip")

# The image's Rust extension requires a root tag even for Python-only tests.
# No Rust target participates in this test application.
bazel_dep(name = "rules_rs", version = "0.1.0")

rust = use_extension("@rules_rs//rs:rules_rust_reexported_extensions.bzl", "rust")
rust.toolchain(versions = [])

# All test application owners use the selected producer's reviewed APT graph.
bazel_dep(name = "rules_distroless", version = "0.9.4.sonic.26")
apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.import_lock(
    lock = "@sonic_build_infra//apt:apt.lock.json",
    requests = "@sonic_build_infra//apt:requests.json",
    sources = "@sonic_build_infra//apt:sources.json",
)

pip.parse(hub_name = "daemon_codegen_pip", python_version = "3.13", requirements_lock = "@sonic_platform_daemons//:bazel/requirements-codegen-lock.txt")
use_repo(pip, "daemon_codegen_pip")

# The original Azure suites explicitly install the legacy SWSS SDK wheel.
bazel_dep(name = "sonic-py-swsssdk", version = "2.0.1-5878f93779df1bfdfe58ea00c8d34fe8261d362e", repo_name = "sonic_py_swsssdk")
