    args = ['$(rootpath @sonic_swss_common//tools/bazel/runtime:test_runtime)', '-', 'enabled', '$(rootpath :unit_runner)', '$(rootpath @sonic_platform_daemons//:sonic-chassisd/setup.py)'],
