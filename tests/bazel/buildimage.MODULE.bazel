module(name = "sonic-buildimage", version = "0.0.0")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "libyang-python", version = "3.1.0.sonic.7", repo_name = "libyang_python")
bazel_dep(name = "rules_python", version = "1.9.0.sonic.2")
bazel_dep(name = "sonic-swss-common", version = "0.0.8-2a4ddd070edb719f2e969a880a5cfff711e64e72", repo_name = "sonic_swss_common")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    environment = {"CC": "gcc", "CXX": "g++"},
    hub_name = "config_engine_pip",
    python_version = "3.13",
    requirements_lock = "//src/sonic-config-engine:requirements_lock.txt",
)
use_repo(pip, "config_engine_pip")
