def get_current_timestamp():
    return datetime.now().strftime("%Y-%m-%d %H:%M:%S")


def try_get(callback, *args, default=NOT_AVAILABLE):
    """Invoke callback; return default on NotImplementedError or None result."""
    try:
        ret = callback(*args)
        if ret is None:
            ret = default
    except NotImplementedError:
        ret = default
    return ret


def fvs_to_dict(fvs):
    """Convert swsscommon FieldValuePairs list of (field, value) tuples to dict."""
    if fvs is None:
        return {}
    if isinstance(fvs, dict):
        return fvs
    return dict(fvs)


class ActionQueue:
    """Three FIFO lanes under one lock, served in order: power_off, graceful_shutdown,
    everything else. put() wakes every waiter."""

    LANE_POWER_OFF, LANE_SHUTDOWN, LANE_NORMAL = 0, 1, 2

    def __init__(self):
        self._lock = threading.Lock()
        self._cond = threading.Condition(self._lock)
        self._lanes = (collections.deque(), collections.deque(), collections.deque())

    @classmethod
    def lane_of(cls, action):
        if action == ACTION_POWER_OFF:
            return cls.LANE_POWER_OFF
        if action == ACTION_GRACEFUL_SHUTDOWN:
            return cls.LANE_SHUTDOWN
        return cls.LANE_NORMAL

    def put(self, item):
        with self._cond:
            self._lanes[self.lane_of(item.action)].append(item)
            self._cond.notify_all()

    def get(self, timeout):
        """Return the next item, or None when nothing arrived within timeout."""
        with self._cond:
            if not any(self._lanes):
                self._cond.wait(timeout)
            for lane in self._lanes:
                if lane:
                    return lane.popleft()
            return None

    def _pending_through_locked(self, lane):
        return any(self._lanes[i] for i in range(lane + 1))

    def pending_through(self, lane):
        """True when a request is queued in `lane` or a lane served before it."""
        with self._lock:
            return self._pending_through_locked(lane)

    def wait_pending_through(self, lane, timeout):
        """Like pending_through(), but waits up to timeout for a put() first; the check and
        the wait share one lock acquisition, so a put() in between is never missed."""
        with self._cond:
            if self._pending_through_locked(lane):
                return True
            self._cond.wait(timeout)
            return self._pending_through_locked(lane)

    def empty(self):
        with self._lock:
            return not any(self._lanes)

    def notify_all(self):
        with self._cond:
            self._cond.notify_all()

    def drain(self):
        with self._lock:
            items = [item for lane in self._lanes for item in lane]
            for lane in self._lanes:
                lane.clear()
        return items


class _StopFlag:
    """The daemon's stop request. It takes no lock, so the signal handler can set it
    whatever the main thread holds; every wait polls it."""

    POLL_SECS = 0.2

    def __init__(self):
        self._set = False

    def set(self):
        self._set = True

    def is_set(self):
        return self._set

    def wait(self, timeout):
        """Return True as soon as the flag is set, False when timeout elapses first."""
        slept = 0.0
        while not self._set:
            if slept >= timeout:
                return False
            step = min(self.POLL_SECS, timeout - slept)
            time.sleep(step)
            slept += step
        return True


class _OpCancel:
    """Cancel view of one running operation: set while the daemon stops or a queued
    request outranks the operation's phase. A power_off outranks every wait; a
    graceful_shutdown outranks the waits of a raise (phase raising) only, so a
    handshake in progress is never cancelled for another graceful request.
    A power-off's own verification consults the stop flag alone instead.
    """

    def __init__(self, daemon, operation):
        self._daemon = daemon
        self._operation = operation

    def _outranking_lane(self):
        if self._operation.phase == PHASE_RAISING:
            return ActionQueue.LANE_SHUTDOWN
        return ActionQueue.LANE_POWER_OFF

    def is_set(self):
        return self._daemon.stop_event.is_set() or \
            self._daemon.action_queue.pending_through(self._outranking_lane())

    def wait(self, timeout):
        """Return True as soon as is_set() holds, False when timeout elapses first."""
        deadline = time.monotonic() + timeout
        while True:
            if self._daemon.stop_event.is_set():
                return True
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return self.is_set()
            if self._daemon.action_queue.wait_pending_through(
                    self._outranking_lane(), min(remaining, 1.0)):
                return True


def classify_report(resp, our_id):
    """Classify one gNOI RebootStatus report for the current operation."""
    if re.findall(TAG_RE, resp.reason) != [our_id] or resp.active:
        return "keep_waiting", None
    if resp.status.message:
        return "forced", OP_REASON_BACKEND_ANSWERED
    if resp.method == system_pb2.HALT and \
            resp.status.status == system_pb2.RebootStatus.STATUS_SUCCESS:
        return "graceful", None
    return "forced", OP_REASON_CHECK_FAILED


class GnoiRpcError(Exception):
    """Normalized gNOI transport failure exposed to operation code."""


class GnoiCredentialError(GnoiRpcError):
    """The client credentials could not be loaded; no request was sent."""


class GnoiRequester:
    """mTLS wrapper around the in-process gNOI client for one operation.

    close() may run on the main thread while the handshake thread is inside an
    RPC; that RPC then fails at once. grpc tolerates a double close, so no lock.
    """

    def __init__(self, target_addr, target_port, cert_paths, server_name):
        self.target_addr = target_addr
        self.target_port = target_port
        self.cert_paths = cert_paths
        self.server_name = server_name
        self._client = None

    def _read_credential(self, field):
        """Read one PEM file; any problem with it is a credential error, not a transport failure."""
        path = self.cert_paths[field]
        if not isinstance(path, str) or not os.path.isabs(path):
            raise GnoiCredentialError("{}: invalid path {!r}".format(field, path))
        try:
            with open(path, "rb") as stream:
                data = stream.read()
        except OSError as e:
            raise GnoiCredentialError("{}: {}".format(field, e)) from e
        if not data:
            raise GnoiCredentialError("{}: empty file {}".format(field, path))
        return data

    def open(self):
        ca_cert = self._read_credential("ca_crt")
        client_key = self._read_credential("client_key")
        client_cert = self._read_credential("client_crt")
        try:
            credentials = grpc.ssl_channel_credentials(
                root_certificates=ca_cert,
                private_key=client_key,
                certificate_chain=client_cert,
            )
            client = GnoiClient(
                "{}:{}".format(self.target_addr, self.target_port),
                options=(("grpc.ssl_target_name_override", self.server_name),),
                credentials=credentials,
            )
            client.__enter__()
        except (ValueError, grpc.RpcError) as e:
            raise GnoiRpcError(str(e)) from e
        self._client = client

    def close(self):
        client = self._client
        self._client = None
        if client is None:
            return
        try:
            client.__exit__(None, None, None)
        except Exception as e:
            raise GnoiRpcError(str(e)) from e

    def _live_client(self):
        client = self._client
        if client is None:
            raise GnoiRpcError("channel closed")
        return client

    def send_halt(self, message, timeout_secs):
        request = system_pb2.RebootRequest(method=system_pb2.HALT, message=message)
        try:
            return self._live_client().system.Reboot(request, timeout=timeout_secs)
        except (grpc.RpcError, RuntimeError, ValueError) as e:
            # RuntimeError: the client was closed under us (a cancellation); ValueError: grpc's own
            raise GnoiRpcError(str(e)) from e

    def poll_status(self, timeout_secs):
        request = system_pb2.RebootStatusRequest()
        try:
            return self._live_client().system.RebootStatus(request, timeout=timeout_secs)
        except (grpc.RpcError, RuntimeError, ValueError) as e:
            raise GnoiRpcError(str(e)) from e


# ============================================================
# SwitchHostController
# ============================================================

class SwitchHostController(EventLogger):
    """
    Wraps platform Module API to power ON/OFF/cycle the Switch-Host and
    tracks its state in the HOST_STATE STATE_DB table.
    """

    def __init__(self, chassis, critical_event_checker=None):
        super(SwitchHostController, self).__init__(SYSLOG_IDENTIFIER, CRITICAL_EVENT_LOG_FILE)
        self.chassis = chassis
        self._switch_host_module = None
        self.critical_event_checker = critical_event_checker
        self.state_db = daemon_base.db_connect("STATE_DB")
        self.config_db = daemon_base.db_connect("CONFIG_DB")

    # A swsscommon.Table is not safe to share between threads, and the event
    # thread calls into this class. No Table is kept: each access builds its own.
    @property
    def host_state_table(self):
        return swsscommon.Table(self.state_db, HOST_STATE_TABLE)

    @property
    def chassis_module_info_table(self):
        return swsscommon.Table(self.state_db, CHASSIS_MODULE_INFO_TABLE)

    @property
    def chassis_module_config_table(self):
        return swsscommon.Table(self.config_db, CHASSIS_MODULE_TABLE)

    def _get_switch_host_module(self):
        """Return the Switch-Host Module object from the chassis module list."""
        if self._switch_host_module is not None:
            return self._switch_host_module
        try:
            modules = self.chassis.get_all_modules()
            for module in modules:
                module_type = try_get(module.get_type, default="")
                if module_type == "SWITCH-HOST":
                    self._switch_host_module = module
                    return self._switch_host_module
            if modules and len(modules) >= 2:
                self._switch_host_module = modules[1]
                return self._switch_host_module
        except Exception as e:
            self.log_error("Failed to retrieve Switch-Host module: {}".format(repr(e)))
        return None

    def get_oper_status(self):
        """Return the current operational status of Switch-Host (ONLINE/OFFLINE)."""
        # device_status: ONLINE | OFFLINE
        module = self._get_switch_host_module()
        if module is None:
            return NOT_AVAILABLE
        raw = try_get(module.get_oper_status, default=NOT_AVAILABLE)
        # Normalise to uppercase to match HOST_STATE DB schema (ONLINE / OFFLINE)
        return str(raw).upper() if raw != NOT_AVAILABLE else raw

    def _verify_oper_status(self, expected_status, timeout_secs, context, cancel):
        """
        Poll get_oper_status() until it matches expected_status or timeout_secs elapses.
        Returns CONFIRMED, NOT_CONFIRMED on timeout, or CANCELLED as soon as cancel is set.
        """
        deadline = time.monotonic() + timeout_secs
        while True:
            if cancel.is_set():
                return PowerCallResult.CANCELLED
            if self.get_oper_status() == expected_status:
                self.log_info("{}: oper_status confirmed {}".format(context, expected_status))
                return PowerCallResult.CONFIRMED
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                break
            if cancel.wait(min(POWER_VERIFY_POLL_INTERVAL_SECS, remaining)):
                return PowerCallResult.CANCELLED
        self.log_error("{}: oper_status did not reach {} within {}s (current: {})".format(
            context, expected_status, timeout_secs, self.get_oper_status()))
        return PowerCallResult.NOT_CONFIRMED

    def _write_label(self, power_state, device_status=None, what="transition"):
        """Best-effort HOST_STATE write; a record failure never stops a power action."""
        try:
            self._update_host_state(power_state, device_status)
        except Exception as e:
            self.log_error("Failed to record Switch-Host {} {}: {}".format(
                what, power_state, repr(e)))

    def _rollback_label(self, prior_power_state, prior_status):
        """Put the prior label back after a request that issued nothing.

        A prior that could not be read is left alone. The live status is not
        consulted: OFFLINE alone must not settle the label to POWERED_OFF, which
        the guard reads as removed power.
        """
        if not prior_power_state or prior_power_state == NOT_AVAILABLE:
            return
        self._write_label(prior_power_state, prior_status, "rollback")

    def _apply_admin_state(self, admin_up, transitional_power_state, final_power_state, expected_oper, op_name,
                           cancel, platform_call=None, verify_timeout=POWER_VERIFY_TIMEOUT_SECS):
        """
        Common implementation for power_on, power_off and power_cycle.
        Snapshots prior STATE_DB values, writes the transitional power state,
        issues set_admin_state, verifies the result, then writes the final power state.
        device_status is always written from module->get_oper_status() (ONLINE|OFFLINE).
        Rolls back to the prior STATE_DB snapshot when the request ends before the platform call.

        admin_up also marks a raise. Before the call: cancel, gate (raises only),
        cancel again. A raise fails closed when its labels cannot be read or written
        (the guard trusts them); a removal goes on to the platform regardless.
        platform_call, when given, is issued instead of set_admin_state. A result
        that is not confirmed keeps the transitional power state.
        """
        module = self._get_switch_host_module()
        if module is None:
            self.log_error("Cannot {} Switch-Host: module not found".format(op_name))
            return PowerCallResult.NOT_CONFIRMED
        if cancel.is_set():
            return PowerCallResult.CANCELLED
        try:
            prior_power_state = self.get_db_power_state()
            prior_status = self.get_db_device_status()
        except Exception as e:
            if admin_up:
                raise
            self.log_error("Failed to read Switch-Host state before {}: {}".format(
                op_name, repr(e)))
            prior_power_state = prior_status = NOT_AVAILABLE
        issued = False
        try:
            # Write transitional power state (e.g. POWERING_ON/OFF) before platform call
            try:
                self._update_host_state(transitional_power_state)
            except Exception as e:
                if admin_up:
                    raise
                self.log_error("Failed to record Switch-Host {} transition: {}".format(
                    op_name, repr(e)))
            if cancel.is_set():
                self._rollback_label(prior_power_state, prior_status)
                return PowerCallResult.CANCELLED
            if admin_up and self.critical_event_checker is not None and \
                    self.critical_event_checker.is_power_on_blocked():
                self.log_warning("{}: refusing Switch-Host {}".format(
                    POWER_ON_BLOCK_REASON, op_name))
                self._rollback_label(prior_power_state, prior_status)
                return PowerCallResult.REFUSED_LEAK
            if cancel.is_set():
                self._rollback_label(prior_power_state, prior_status)
                return PowerCallResult.CANCELLED
            issued = True
            if platform_call is None:
                module.set_admin_state(admin_up)
            else:
                platform_call(module)
            self.log_notice("Switch-Host {} issued; verifying oper_status...".format(op_name))
            verified = self._verify_oper_status(expected_oper, verify_timeout, op_name, cancel)
            if verified == PowerCallResult.CANCELLED:
                return verified
            if verified != PowerCallResult.CONFIRMED:
                self.log_error("Switch-Host {}: oper_status did not confirm {}".format(
                    op_name, expected_oper))
                # unconfirmed: keep the transitional label, refresh the live status
                self._write_label(transitional_power_state)
                return verified
            # Write final stable power state (e.g. POWER_ON/OFF); device_status from live oper_status
            self._write_label(final_power_state, what="final label")
            return verified
        except Exception as e:
            self.log_error("Failed to {} Switch-Host: {}".format(op_name, repr(e)))
            if not issued:
                self._rollback_label(prior_power_state, prior_status)
            if cancel.is_set():
                return PowerCallResult.CANCELLED
            # an issued call may still take effect: its transitional label stays
            return PowerCallResult.NOT_CONFIRMED

    def power_on(self, cancel):
        """Power ON the Switch-Host via module->set_admin_state(True).

        device_power_state: POWERING_ON (transitional) -> POWER_ON (final)
        device_status:      ONLINE | OFFLINE from module->get_oper_status()
        """
        return self._apply_admin_state(
            True, SWITCH_HOST_POWERING_ON, POWER_STATE_ON, SWITCH_HOST_ONLINE, "power_on", cancel)

    def power_off(self, cancel):
        """Power OFF the Switch-Host via module->set_admin_state(False).

        device_power_state: POWERING_OFF (transitional) -> POWER_OFF (final)
        device_status:      ONLINE | OFFLINE from module->get_oper_status()
        """
        return self._apply_admin_state(
            False, SWITCH_HOST_POWERING_OFF, POWER_STATE_OFF, SWITCH_HOST_OFFLINE, "power_off", cancel)

    def power_cycle(self, cancel):
        """Power cycle the Switch-Host via module->do_power_cycle().

        device_power_state: POWER_CYCLING (transitional) -> POWER_CYCLE (final)
        device_status:      ONLINE | OFFLINE from module->get_oper_status()
        """
        # Use 2x timeout: host must go offline then come back online
        return self._apply_admin_state(
            True, SWITCH_HOST_POWER_CYCLING, POWER_STATE_CYCLE, SWITCH_HOST_ONLINE, "power_cycle", cancel,
            platform_call=lambda module: try_get(module.do_power_cycle, default=False),
            verify_timeout=POWER_VERIFY_TIMEOUT_SECS * 2)

    def _update_host_state(self, power_state, device_status=None):
        """Write device_power_state and device_status to HOST_STATE STATE_DB.

        power_state   : device_power_state field value.
                        Transitional: POWERING_ON | POWERING_OFF | POWER_CYCLING
                        Final/stable: POWER_ON | POWER_OFF | POWER_CYCLE | GRACEFUL_SHUT
        device_status : device_status field value — always ONLINE | OFFLINE.
                        When None, fetched live from module->get_oper_status().
        """
        if device_status is None:
            device_status = self.get_oper_status()
        fvs = swsscommon.FieldValuePairs([
            (FIELD_DEVICE_POWER_STATE, power_state),
            (FIELD_DEVICE_STATUS, str(device_status)),
            (FIELD_LAST_CHANGE_TIMESTAMP, get_current_timestamp()),
        ])
        self.host_state_table.set(HOST_STATE_KEY, fvs)
        self._update_chassis_module_oper_status(device_status)

    def get_db_device_status(self):
        """Read device_status from HOST_STATE STATE_DB (reflects transitional states)."""
        result = self.host_state_table.get(HOST_STATE_KEY)
        if result and result[0]:
            return fvs_to_dict(result[1]).get(FIELD_DEVICE_STATUS, NOT_AVAILABLE)
        return NOT_AVAILABLE

    def get_db_power_state(self):
        """Read device_power_state from HOST_STATE STATE_DB."""
        result = self.host_state_table.get(HOST_STATE_KEY)
        if result and result[0]:
            return fvs_to_dict(result[1]).get(FIELD_DEVICE_POWER_STATE, NOT_AVAILABLE)
        return NOT_AVAILABLE

    def write_operation_start(self, request_id, trigger):
        self.host_state_table.set(HOST_STATE_KEY, swsscommon.FieldValuePairs([
            (FIELD_OP_REQUEST_ID, request_id),
            (FIELD_OP_TRIGGER, trigger),
            (FIELD_OP_RESULT, "-"),
            (FIELD_OP_REASON, "-"),
        ]))

    def write_operation_terminal(self, request_id, trigger, op_result, op_reason):
        """One write for the whole record, so a failed start write cannot misattribute it."""
        self.host_state_table.set(HOST_STATE_KEY, swsscommon.FieldValuePairs([
            (FIELD_OP_REQUEST_ID, request_id),
            (FIELD_OP_TRIGGER, trigger),
            (FIELD_OP_RESULT, op_result),
            (FIELD_OP_REASON, op_reason),
        ]))

    def init_host_state(self):
        """Set device_power_state from live oper_status (ONLINE -> POWERED_ON, OFFLINE -> POWERED_OFF).

        Called only at daemon startup. OFFLINE overwrites only a POWERED_OFF or missing
        state: a state written before a platform call is no evidence that power was
        removed, and the guard trusts POWERED_OFF. A reading that is neither keeps the
        state too. An operation record left open by the previous run is closed as
        abandoned first.
        """
        stale_state = NOT_AVAILABLE
        result = self.host_state_table.get(HOST_STATE_KEY)
        if result and result[0]:
            entry = fvs_to_dict(result[1])
            stale_state = entry.get(FIELD_DEVICE_POWER_STATE, NOT_AVAILABLE)
            request_id = entry.get(FIELD_OP_REQUEST_ID, "-")
            if request_id not in ("-", "") and entry.get(FIELD_OP_RESULT) in (None, "-"):
                self.write_operation_terminal(
                    request_id, entry.get(FIELD_OP_TRIGGER, "-"), OP_RESULT_ABANDONED, "-")
                hint = ""
                if stale_state in (SWITCH_HOST_POWERING_OFF, SWITCH_HOST_GRACEFUL_SHUTTING_DOWN):
                    hint = "; the host may still be powered: a power-off must precede the next power-on"
                self.log_warning(
                    "OP_ABANDONED request_id={} stale_state={}{}".format(
                        request_id, stale_state, hint))

        oper_status = self.get_oper_status()
        if oper_status == SWITCH_HOST_ONLINE:
            power_state = POWER_STATE_ON
        elif oper_status == SWITCH_HOST_OFFLINE:
            power_state = POWER_STATE_OFF if stale_state in (NOT_AVAILABLE, POWER_STATE_OFF) else stale_state
        else:
            self.log_warning("STARTUP: Switch-Host oper_status={}; keeping recorded power state {}".format(
                oper_status, stale_state))
            power_state = stale_state
        self._update_host_state(power_state, oper_status)

    def initialize_chassis_module(self, admin_status):
        """Populate CHASSIS_MODULE|SWITCH-HOST in both CONFIG_DB and STATE_DB at daemon startup.

        CONFIG_DB|CHASSIS_MODULE|SWITCH-HOST is seeded with the supplied admin_status
        and default timings (power_on_delay=300, graceful_shutdown_timeout=120) only when
        no entry exists, so any operator override persisted from a prior boot is preserved.
        STATE_DB|CHASSIS_MODULE_TABLE|SWITCH-HOST is always (re)populated with module
        identity, current oper_status, and the supplied admin_status.
        """
        # 1. Seed CONFIG_DB defaults if absent (don't clobber operator config).
        existing = self.chassis_module_config_table.get(SWITCH_HOST_MODULE_KEY)
        if not (existing and existing[0]):
            self.chassis_module_config_table.set(SWITCH_HOST_MODULE_KEY, swsscommon.FieldValuePairs([
                (CHASSIS_MODULE_INFO_ADMIN_STATUS_FIELD, admin_status),
                (FIELD_POWER_ON_DELAY, str(DEFAULT_POWER_ON_DELAY_SECS)),
                (FIELD_GRACEFUL_SHUTDOWN_TIMEOUT, str(DEFAULT_SHUTDOWN_DELAY_SECS)),
            ]))
            self.log_info(
                "CONFIG_DB CHASSIS_MODULE|SWITCH-HOST seeded: "
                "admin_status={} power_on_delay={} graceful_shutdown_timeout={}".format(
                    admin_status, DEFAULT_POWER_ON_DELAY_SECS, DEFAULT_SHUTDOWN_DELAY_SECS))

        # 2. Populate STATE_DB CHASSIS_MODULE_TABLE with module identity + status.
        module = self._get_switch_host_module()
        if module is None:
            self.log_error("Cannot initialize CHASSIS_MODULE_INFO: Switch-Host module not found")
            return
        name = SWITCH_HOST_MODULE_KEY
        desc = try_get(module.get_description, default=NOT_AVAILABLE)
        serial = try_get(module.get_serial, default=NOT_AVAILABLE)
        oper_status = self.get_oper_status()
        fvs = swsscommon.FieldValuePairs([
            (CHASSIS_MODULE_INFO_NAME_FIELD, name),
            (CHASSIS_MODULE_INFO_DESC_FIELD, desc),
            (CHASSIS_MODULE_INFO_SERIAL_FIELD, serial),
            (CHASSIS_MODULE_INFO_OPERSTATUS_FIELD, oper_status),
            (CHASSIS_MODULE_INFO_ADMIN_STATUS_FIELD, admin_status),
        ])
        self.chassis_module_info_table.set(SWITCH_HOST_MODULE_KEY, fvs)
        self.log_info(
            "CHASSIS_MODULE_INFO initialized for SWITCH-HOST: "
            "name={} serial={} admin_status={} oper_status={}".format(
                name, serial, admin_status, oper_status))

    def _update_chassis_module_oper_status(self, oper_status):
        """Update oper_status in CHASSIS_MODULE_TABLE|SWITCH-HOST to mirror HOST_STATE."""
        fvs = swsscommon.FieldValuePairs([
            (CHASSIS_MODULE_INFO_OPERSTATUS_FIELD, str(oper_status)),
        ])
        self.chassis_module_info_table.set(SWITCH_HOST_MODULE_KEY, fvs)

    def update_chassis_module_admin_status(self, admin_status):
        """Update admin_status in CHASSIS_MODULE_TABLE|SWITCH-HOST when config changes."""
        fvs = swsscommon.FieldValuePairs([
            (CHASSIS_MODULE_INFO_ADMIN_STATUS_FIELD, admin_status),
        ])
        self.chassis_module_info_table.set(SWITCH_HOST_MODULE_KEY, fvs)


# ============================================================
# PolicyReader
# ============================================================

class PolicyReader(EventLogger):
    """Reads bmcctld timing and leak policy configuration from CONFIG_DB."""

    def __init__(self):
        super(PolicyReader, self).__init__(SYSLOG_IDENTIFIER)
        self.config_db = daemon_base.db_connect("CONFIG_DB")

    def _get_chassis_module_entry(self):
        """Return the CHASSIS_MODULE|SWITCH-HOST entry as a dict (empty dict if missing)."""
        tbl = swsscommon.Table(self.config_db, CHASSIS_MODULE_TABLE)
        result = tbl.get(SWITCH_HOST_MODULE_KEY)
        if result and result[0]:
            return fvs_to_dict(result[1])
        return {}

    def get_switch_host_admin_status(self, default=ADMIN_DOWN):
        """Return admin_status for SWITCH-HOST from CHASSIS_MODULE|SWITCH-HOST.

        When no entry exists, the supplied default is returned.  Callers pass
        ADMIN_UP for air-cooled systems (no liquid-flow safety gate) and
        ADMIN_DOWN for liquid-cooled systems (must wait for explicit admin-up).
        """
        return self._get_chassis_module_entry().get(FIELD_ADMIN_STATUS, default)

    def get_power_on_delay(self):
        """Return power_on_delay in seconds from CHASSIS_MODULE|SWITCH-HOST (default: 0)."""
        raw = self._get_chassis_module_entry().get(FIELD_POWER_ON_DELAY)
        if raw is not None:
            try:
                return int(raw)
            except (ValueError, TypeError):
                pass
        return DEFAULT_POWER_ON_DELAY_SECS

    def get_graceful_shutdown_timeout(self):
        """Return graceful_shutdown_timeout in seconds from CHASSIS_MODULE|SWITCH-HOST (default: 120)."""
        raw = self._get_chassis_module_entry().get(FIELD_GRACEFUL_SHUTDOWN_TIMEOUT)
        if raw is not None:
            try:
                value = int(raw)
                if value >= 0:
                    return value
            except (ValueError, TypeError):
                pass
        return DEFAULT_SHUTDOWN_DELAY_SECS

    def get_gnoi_cert_paths(self):
        """Client credential paths: CONFIG_DB GNMI_CLIENT|certs, else the /etc/sonic/credentials defaults.

        Nothing else is consulted, so a BMC without link credentials is not_qualified.
        """
        table = swsscommon.Table(self.config_db, GNMI_CLIENT_TABLE)
        result = table.get("certs")
        entry = fvs_to_dict(result[1]) if result and result[0] else {}
        return {field: entry.get(field, default)
                for field, default in DEFAULT_GNOI_CERT_PATHS.items()}

    @staticmethod
    def default_leak_control_policy():
        return {
            "system_leak_policy": DEFAULT_SYSTEM_LEAK_POLICY,
            "system_critical_leak_action": DEFAULT_SYSTEM_CRITICAL_LEAK_ACTION,
            "system_major_leak_action": DEFAULT_SYSTEM_MAJOR_LEAK_ACTION,
            "system_minor_leak_action": DEFAULT_SYSTEM_MINOR_LEAK_ACTION,
            "rack_mgr_leak_policy": DEFAULT_RACK_MGR_LEAK_POLICY,
            "rack_mgr_critical_alert_action": DEFAULT_RACK_MGR_CRITICAL_ALERT_ACTION,
            "rack_mgr_major_alert_action": DEFAULT_RACK_MGR_MAJOR_ALERT_ACTION,
            "rack_mgr_minor_alert_action": DEFAULT_RACK_MGR_MINOR_ALERT_ACTION,
        }

    def get_leak_control_policy(self):
        """Return LEAK_CONTROL_POLICY as a dict with action defaults filled in."""
        policy = self.default_leak_control_policy()
        tbl = swsscommon.Table(self.config_db, LEAK_CONTROL_POLICY_TABLE)
        # LEAK_CONTROL_POLICY is a single-row table; CLI writes key "policy", legacy variants also tried
        for key in ("policy", LEAK_CONTROL_POLICY_TABLE, ""):
            result = tbl.get(key)
            if result and result[0]:
                policy.update({k: v for k, v in fvs_to_dict(result[1]).items() if k in policy})
                break
        return policy


# ============================================================
# CriticalEventChecker
# ============================================================

class CriticalEventChecker(logger.Logger):
    """Checks current system and Rack Manager leak/alert status from STATE_DB."""

    # Alert keys in RACK_MANAGER_ALERT table
    ALERT_KEYS = [
        "Inlet_liquid_temperature",
        "Inlet_liquid_flow_rate",
        "Inlet_liquid_pressure",
        "Rack_level_leak",
    ]

    def __init__(self, policy_reader):
        super(CriticalEventChecker, self).__init__(SYSLOG_IDENTIFIER)
        self.state_db = daemon_base.db_connect("STATE_DB")
        self.policy_reader = policy_reader

    def has_critical_system_leak(self):
        """Return True if SYSTEM_LEAK_STATUS|system shows CRITICAL_SYSTEM_LEAK."""
        tbl = swsscommon.Table(self.state_db, SYSTEM_LEAK_STATUS_TABLE)
        result = tbl.get(SYSTEM_LEAK_STATUS_KEY)
        if result and result[0]:
            d = fvs_to_dict(result[1])
            if d.get(FIELD_TEST_LEAK) != "Enabled" and d.get(FIELD_DEVICE_LEAK_STATUS) == SystemLeakStatus.CRITICAL:
                return True
        return False

    def has_critical_rack_mgr_alert(self):
        """Return True if any RACK_MANAGER_ALERT entry has CRITICAL severity."""
        tbl = swsscommon.Table(self.state_db, RACK_MANAGER_ALERT_TABLE)
        for alert_key in self.ALERT_KEYS:
            result = tbl.get(alert_key)
            if result and result[0]:
                d = fvs_to_dict(result[1])
                # severity field for temperature/flow/pressure; leak field for rack-level leak
                severity = d.get(FIELD_SEVERITY) or d.get(FIELD_LEAK, ALERT_SEVERITY_NORMAL)
                if severity == ALERT_SEVERITY_CRITICAL:
                    return True
        return False

    def get_highest_rack_mgr_alert_severity(self):
        """Return the highest active RACK_MANAGER_ALERT severity (CRITICAL > MAJOR > MINOR), or None."""
        tbl = swsscommon.Table(self.state_db, RACK_MANAGER_ALERT_TABLE)
        active = set()
        for alert_key in self.ALERT_KEYS:
            result = tbl.get(alert_key)
            if result and result[0]:
                d = fvs_to_dict(result[1])
                active.add(d.get(FIELD_SEVERITY) or d.get(FIELD_LEAK, ALERT_SEVERITY_NORMAL))
        for severity in LEAK_SEVERITIES_HIGH_TO_LOW:
            if severity in active:
                return severity
        return None

    @staticmethod
    def _power_down_configured(policy, severity, action_key_fmt):
        """Return True if the action for `severity` or any lower severity is a power-down action."""
        for sev in LEAK_SEVERITIES_HIGH_TO_LOW[LEAK_SEVERITIES_HIGH_TO_LOW.index(severity):]:
            if policy.get(action_key_fmt.format(sev.lower())) in POWER_DOWN_ACTIONS:
                return True
        return False

    def has_power_down_event(self):
        """Return True if an active leak/alert has a power-down action configured for its
        severity or any lower one. Powering the Switch-Host on would only be undone by that action.

        Skips the system check if system_leak_policy == 'disabled' and the Rack Manager
        check if rack_mgr_leak_policy == 'disabled'.
        """
        policy = self.policy_reader.get_leak_control_policy()
        if policy.get("system_leak_policy") != "disabled":
            status = self.get_system_leak_status()
            if status in LEAK_SEVERITIES_HIGH_TO_LOW and \
                    self._power_down_configured(policy, status, "system_{}_leak_action"):
                return True
        if policy.get("rack_mgr_leak_policy") != "disabled":
            severity = self.get_highest_rack_mgr_alert_severity()
            if severity and self._power_down_configured(policy, severity, "rack_mgr_{}_alert_action"):
                return True
        return False

    def is_power_on_blocked(self):
        """Return True if Switch-Host power-on must be blocked.

        Blocked when a CRITICAL system leak or Rack Manager alert is active, or when an
        active MAJOR/MINOR leak or alert has a power-down action configured for its
        severity or a lower one (see has_power_down_event). Policies set to 'disabled'
        are skipped.
        """
        policy = self.policy_reader.get_leak_control_policy()
        if policy.get("system_leak_policy") != "disabled" and self.has_critical_system_leak():
            return True
        if policy.get("rack_mgr_leak_policy") != "disabled" and self.has_critical_rack_mgr_alert():
            return True
        return self.has_power_down_event()

    def get_system_leak_status(self):
        """Return device_leak_status string from SYSTEM_LEAK_STATUS table."""
        tbl = swsscommon.Table(self.state_db, SYSTEM_LEAK_STATUS_TABLE)
        result = tbl.get(SYSTEM_LEAK_STATUS_KEY)
        if result and result[0]:
            d = fvs_to_dict(result[1])
            # A test aggregate is never used for power-on gating.
            return "" if d.get(FIELD_TEST_LEAK) == "Enabled" else d.get(FIELD_DEVICE_LEAK_STATUS, "")
        return ""


# ============================================================
# GracefulShutdownHandler
# ============================================================

class GracefulShutdownHandler(EventLogger):
    """
    Sends a tagged gNOI HALT, waits for its attributed terminal report within
    one deadline, then removes Switch-Host power.

    Runs on the main thread. Only the handshake runs on a helper thread
    ("bmcctld-graceful") that touches neither the platform nor Redis; the main
    thread cancels it when a POWER_OFF is queued or the daemon stops and never
    waits for it beyond a bound. Terminal records are written by the daemon.
    """

    def __init__(self, controller, policy_reader, stop_event):
        super(GracefulShutdownHandler, self).__init__(SYSLOG_IDENTIFIER)
        self._event_log = _event_logger  # for critical leak / alert events only
        self.controller = controller
        self.policy_reader = policy_reader
        self.stop_event = stop_event
        self._handshake_thread = None

    def _rpc_failure_reason(self, operation, what, exc):
        """preempted after a cancel; not_qualified when the credentials are unusable; else rpc_failure."""
        if self._leg_cancelled(operation):
            return OP_REASON_PREEMPTED
        if isinstance(exc, GnoiCredentialError):
            self.log_warning("BMC gNOI client credentials not usable: {}".format(str(exc)))
            return OP_REASON_NOT_QUALIFIED
        self.log_warning("GNOI {} RPC failed: {}".format(what, str(exc)))
        return OP_REASON_RPC_FAILURE

    @staticmethod
    def _leg_cancelled(operation):
        """The handshake thread's cancel: the operation's, or the main thread having given up on it."""
        return operation.abandoned or operation.cancel.is_set()

    def _close_requester(self, operation):
        """Close the channel the handshake thread published, so a blocked RPC fails at once."""
        requester = operation.requester
        if requester is not None:
            try:
                requester.close()
            except Exception as e:
                self.log_warning("GNOI channel close on cancellation failed: {}".format(str(e)))

    def _run_shutdown_leg(self, operation, requester_factory):
        """Run the handshake; returns (graceful, reason), reason being "-" after a graceful leg.

        Whatever ends the handshake, bmcctld's own exception included, the leg is
        graceful or forced and the caller's power-off follows.
        """
        try:
            if operation.cancel.is_set():
                graceful, reason = False, OP_REASON_PREEMPTED   # no label, no thread, no HALT
            else:
                timeout = self.policy_reader.get_graceful_shutdown_timeout()
                cert_paths = self.policy_reader.get_gnoi_cert_paths()
                self.log_notice(
                    "Initiating graceful shutdown of Switch-Host (timeout={}s)".format(timeout))
                self.controller._write_label(SWITCH_HOST_GRACEFUL_SHUTTING_DOWN)
                if timeout == 0:
                    graceful, reason = False, OP_REASON_TIMEOUT_ZERO
                elif self._handshake_thread is not None and self._handshake_thread.is_alive():
                    # an abandoned thread is still winding down; it sends nothing, so force rather than fail
                    self.log_error("Previous graceful handshake thread still alive; forcing request_id={}".format(
                        operation.request_id))
                    graceful, reason = False, OP_REASON_UNCLASSIFIED
                else:
                    graceful, reason = self._handshake_on_thread(
                        operation, requester_factory, cert_paths, time.monotonic() + timeout)
        except Exception as e:
            self.log_error("Graceful leg failed request_id={}: {}\n{}".format(
                operation.request_id, repr(e), traceback.format_exc()))
            graceful = False
            reason = OP_REASON_PREEMPTED if operation.cancel.is_set() else OP_REASON_UNCLASSIFIED
        operation.leg_reason = "-" if graceful else (reason or OP_REASON_UNCLASSIFIED)
        return graceful, operation.leg_reason

    def _handshake_on_thread(self, operation, requester_factory, cert_paths, deadline):
        """Run the handshake on the helper thread and wait for it, but not for ever.

        A cancellation closes the channel, so the thread normally returns within a
        second. One still alive HANDSHAKE_JOIN_SECS after the cancellation, or at
        the handshake's hard limit, is abandoned and sends no HALT once it wakes.
        """
        thread = threading.Thread(
            target=self._handshake,
            args=(operation, requester_factory, cert_paths, deadline),
            daemon=True,
            name="bmcctld-graceful",
        )
        try:
            thread.start()
        except Exception as e:
            self.log_error("Cannot start the graceful handshake thread request_id={}: {}".format(
                operation.request_id, repr(e)))
            return False, OP_REASON_UNCLASSIFIED
        self._handshake_thread = thread
        # The helper's RPC timeouts are bounded by the remaining time, so it returns at
        # the deadline on its own; the allowance covers its unwinding only.
        hard_limit = deadline + HANDSHAKE_JOIN_SECS
        cancelled_at = None
        while thread.is_alive():
            thread.join(GRACEFUL_JOIN_SLICE_SECS)
            if not thread.is_alive():
                break
            now = time.monotonic()
            if cancelled_at is None and operation.cancel.is_set():
                cancelled_at = now
                self._event_log.log_notice(
                    "Graceful handshake cancelled request_id={} cause={}".format(
                        operation.request_id,
                        "stop" if self.stop_event.is_set() else "power_off"))
                self._close_requester(operation)
            waited_out = cancelled_at is not None and now - cancelled_at >= HANDSHAKE_JOIN_SECS
            if waited_out or now >= hard_limit:
                operation.abandoned = True
                self._close_requester(operation)
                self.log_error("Graceful handshake abandoned after {:.0f}s request_id={}".format(
                    now - (cancelled_at if waited_out else deadline), operation.request_id))
                if operation.cancel.is_set():
                    # The queued power_off (or the stop) owns the power domain now.
                    return False, OP_REASON_PREEMPTED
                return False, OP_REASON_UNCLASSIFIED    # own handshake wedged
        return operation.leg or (False, OP_REASON_UNCLASSIFIED)

    def _handshake(self, operation, requester_factory, cert_paths, deadline):
        """The helper thread: open the channel, send the tagged HALT, wait for its
        attributed report and leave (graceful, reason) in operation.leg.

        The requester is published on the operation so the main thread can close a
        channel blocked in an RPC; it is closed here whatever happened.
        """
        try:
            requester = requester_factory(
                self._get_switch_host_addr(),
                self._get_switch_host_gnoi_port(),
                cert_paths,
                GNOI_SERVER_NAME,
            )
            operation.requester = requester
            try:
                operation.leg = self._halt_and_poll(operation, requester, deadline)
            finally:
                operation.requester = None
                try:
                    requester.close()
                except GnoiRpcError as e:
                    self.log_warning("GNOI channel close failed: {}".format(str(e)))
        except Exception as e:
            self.log_error("Graceful leg failed request_id={}: {}\n{}".format(
                operation.request_id, repr(e), traceback.format_exc()))
            operation.leg = (False, OP_REASON_PREEMPTED if self._leg_cancelled(operation)
                             else OP_REASON_UNCLASSIFIED)

    def _halt_and_poll(self, operation, requester, deadline):
        """The handshake proper; every wait and RPC boundary consults the cancel."""
        if self._leg_cancelled(operation):
            return False, OP_REASON_PREEMPTED
        try:
            requester.open()
        except GnoiRpcError as e:
            return False, self._rpc_failure_reason(operation, "shutdown", e)
        if self._leg_cancelled(operation):
            return False, OP_REASON_PREEMPTED
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            return False, OP_REASON_DEADLINE
        self.log_notice("Sending tagged GNOI HALT request_id={}".format(operation.request_id))
        try:
            requester.send_halt(
                "BMC pre-shutdown request [bmc-req:{}]".format(operation.request_id),
                timeout_secs=min(GNOI_REQUEST_TIMEOUT_SECS, remaining),
            )
        except GnoiRpcError as e:
            return False, self._rpc_failure_reason(operation, "shutdown", e)

        while True:
            if self._leg_cancelled(operation):
                return False, OP_REASON_PREEMPTED
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return False, OP_REASON_DEADLINE
            try:
                response = requester.poll_status(
                    timeout_secs=min(GNOI_STATUS_RPC_TIMEOUT_SECS, remaining))
            except GnoiRpcError as e:
                if time.monotonic() >= deadline and not self._leg_cancelled(operation):
                    return False, OP_REASON_DEADLINE    # the deadline, not the host, ended this poll
                return False, self._rpc_failure_reason(operation, "status", e)
            if self._leg_cancelled(operation):
                return False, OP_REASON_PREEMPTED
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return False, OP_REASON_DEADLINE
            classification, report_reason = classify_report(response, operation.request_id)
            if classification == "graceful":
                self.log_notice(
                    "Tagged graceful completion received request_id={}".format(
                        operation.request_id))
                return True, None
            if classification == "forced":
                self.log_notice(
                    "Tagged terminal failure received request_id={} reason={}".format(
                        operation.request_id, report_reason))
                return False, report_reason
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                return False, OP_REASON_DEADLINE
            operation.cancel.wait(min(GNOI_STATUS_POLL_INTERVAL_SECS, remaining))

    def execute(self, operation, requester_factory):
        """Run one tagged graceful shutdown, then remove host power.

        Returns (op_result, op_reason, success).
        """
        graceful, reason = self._run_shutdown_leg(operation, requester_factory)
        if reason == OP_REASON_PREEMPTED:
            return OP_RESULT_PREEMPTED, OP_REASON_PREEMPTED, False

        # The platform call is made whatever the host reads now: OFFLINE alone
        # proves nothing (a booting host, a halted but powered one). Only the
        # daemon stop cuts a power-off short; a queued power_off waits for it.
        power_result = self.controller.power_off(self.stop_event)
        if power_result == PowerCallResult.CANCELLED:
            return OP_RESULT_PREEMPTED, reason, False
        if power_result != PowerCallResult.CONFIRMED:
            self._event_log.log_error(
                "POWER_OFF_FAILED request_id={}".format(operation.request_id))
            return OP_RESULT_POWER_OFF_FAILED, reason, False
        return (OP_RESULT_SUCCESS_GRACEFUL if graceful else OP_RESULT_SUCCESS_FORCED), reason, True

    def _read_bmc_link_data(self):
        """Read available bmc.json files in precedence order."""
        for path in BMC_JSON_PATHS:
            try:
                with open(path) as f:
                    data = json.load(f)
            except (json.JSONDecodeError, OSError):
                continue
            if not isinstance(data, dict):
                self.log_warning("Ignoring {}: not a JSON object".format(path))
                continue
            yield data

    def _get_switch_host_addr(self):
        """Read Switch-Host address from bmc.json; fall back to hardcoded default."""
        for data in self._read_bmc_link_data():
            addr = data.get("bmc_if_addr")
            if addr:
                return addr
        return DEFAULT_SWITCH_HOST_ADDR

    def _get_switch_host_gnoi_port(self):
        """Read the Switch-Host gNMI port from bmc.json."""
        for data in self._read_bmc_link_data():
            port = data.get("switch_host_gnmi_port")
            if port is not None:
                return port
        return DEFAULT_SWITCH_HOST_GNMI_PORT


# ============================================================
# BmcEventHandler
# ============================================================

class BmcEventHandler(EventLogger):
    """
    Runs in a dedicated daemon thread.  Subscribes to RACK_MANAGER_COMMAND,
    CHASSIS_MODULE, RACK_MANAGER_ALERT, and SYSTEM_LEAK_STATUS tables.

    On each event it decides what action is needed and puts an ActionItem on
    action_queue.  All blocking power operations are executed by the main
    daemon thread — this class never blocks.
    """

    def __init__(self, action_queue, policy_reader, critical_event_checker, stop_event,
                 controller):
        super(BmcEventHandler, self).__init__(SYSLOG_IDENTIFIER)
        self._event_log = _event_logger  # for critical leak / alert events only
        self.action_queue = action_queue
        self.policy_reader = policy_reader
        self.critical_event_checker = critical_event_checker
        self.stop_event = stop_event
        self.controller = controller

        self.state_db = daemon_base.db_connect("STATE_DB")
        self.config_db = daemon_base.db_connect("CONFIG_DB")

        # Act on RACK_MANAGER_ALERT severity changes only.
        # Rack Manager (redfish docker) may republish identical rows each cycle.
        self._last_rack_mgr_alert_severity = {}

        # Act on CHASSIS_MODULE admin_status transitions only.
        self._last_chassis_module_admin_status = {}

        # One SubscriberStateTable per watched table
        self.rack_mgr_cmd_sub = swsscommon.SubscriberStateTable(
            self.state_db, RACK_MANAGER_COMMAND_TABLE)
        self.chassis_module_sub = swsscommon.SubscriberStateTable(
            self.config_db, CHASSIS_MODULE_TABLE)
        self.rack_mgr_alert_sub = swsscommon.SubscriberStateTable(
            self.state_db, RACK_MANAGER_ALERT_TABLE)
        self.rack_mgr_data_sub = swsscommon.SubscriberStateTable(
            self.state_db, RACK_MANAGER_DATA_TABLE)
        self.system_leak_sub = swsscommon.SubscriberStateTable(
            self.state_db, SYSTEM_LEAK_STATUS_TABLE)

        # Map fd -> (table, handler).
        # getFd() returns a stable integer regardless of how swsscommon re-wraps
        # the C++ Selectable* returned by sel.select().  The table reference is
        # kept here because sel.select() returns a raw Selectable that has
        # getFd() but no pop(); pop() must be called on the original
        # SubscriberStateTable object.
        self._subscribers = {
            self.rack_mgr_cmd_sub.getFd():   (self.rack_mgr_cmd_sub,   self._handle_rack_mgr_command),
            self.chassis_module_sub.getFd(): (self.chassis_module_sub, self._handle_chassis_module),
            self.rack_mgr_alert_sub.getFd(): (self.rack_mgr_alert_sub, self._handle_rack_mgr_alert),
            self.rack_mgr_data_sub.getFd():  (self.rack_mgr_data_sub,  self._handle_rack_mgr_data),
            self.system_leak_sub.getFd():    (self.system_leak_sub,    self._handle_system_leak),
        }

        self.sel = swsscommon.Select()
        self.sel.addSelectable(self.rack_mgr_cmd_sub)
        self.sel.addSelectable(self.chassis_module_sub)
        self.sel.addSelectable(self.rack_mgr_alert_sub)
        self.sel.addSelectable(self.rack_mgr_data_sub)
        self.sel.addSelectable(self.system_leak_sub)

    def seed_chassis_module_admin_status(self):
        """
        Record the current CONFIG admin_status before the event loop starts.

        SubscriberStateTable replays existing CHASSIS_MODULE rows on subscribe. Without
        seeding, the replay can look like a new admin transition and enqueue
        ACTION_POWER_ON before HOST_STATE is synchronized and before the main-thread
        action loop is ready to process the queue.
        """
        admin_status = self.policy_reader._get_chassis_module_entry().get(FIELD_ADMIN_STATUS, "")
        if admin_status:
            self._last_chassis_module_admin_status[SWITCH_HOST_MODULE_KEY] = admin_status
            self.log_info(
                "Seeded CHASSIS_MODULE admin_status dedup for {}: {}".format(
                    SWITCH_HOST_MODULE_KEY, admin_status))

    # ---- public ----

    def run_event_loop(self):
        """Block in select loop until stop_event is set."""
        # A failing iteration is logged and skipped. EVENT_LOOP_FAILURE_LIMIT select()
        # failures in a row stop the daemon, so that supervisord restarts it instead of
        # leaving it deaf. A failure in pop() or in a handler loses that event only: the
        # next select() resets the count.
        self.log_info("Entering event subscription loop")
        failures = 0
        while not self.stop_event.is_set():
            try:
                state, selectable = self.sel.select(SELECT_TIMEOUT_MSECS)
                if state == swsscommon.Select.TIMEOUT:
                    failures = 0
                    continue
                if state != swsscommon.Select.OBJECT:
                    raise RuntimeError("sel.select() returned unexpected state: {}".format(state))
                failures = 0
                fd = selectable.getFd()
                entry = self._subscribers.get(fd)
                if entry is None:
                    self.log_warning("sel.select() returned unknown fd={}".format(fd))
                    continue
                table, handler = entry
                key, op, fvs = table.pop()
                if op != "SET":
                    continue
                handler(key, fvs_to_dict(fvs))
            except Exception as e:
                failures += 1
                self.log_error("Event loop iteration failed: {}\n{}".format(
                    repr(e), traceback.format_exc()))
                if failures >= EVENT_LOOP_FAILURE_LIMIT:
                    self.log_error("Event loop failed {} times in a row; stopping for a restart".format(failures))
                    self.stop_event.set()
                    return
                time.sleep(1)   # a select() that keeps failing must not spin

    # ---- internal event handlers ----

    def _handle_rack_mgr_command(self, key, fvs):
        """Process a RACK_MANAGER_COMMAND entry (POWER_ON / POWER_OFF / POWER_CYCLE)."""
        command = fvs.get(FIELD_COMMAND, "")
        cmd_status = fvs.get(FIELD_STATUS, "")

        # Skip already-processed commands
        if cmd_status not in (CMD_STATUS_PENDING, ""):
            return

        self.log_notice("Rack Manager command: key={} command={}".format(key, command))
        self._set_cmd_status(key, CMD_STATUS_IN_PROGRESS)

        if command == CMD_POWER_ON:
            if self.critical_event_checker.is_power_on_blocked():
                self._event_log.log_warning(
                    "RACK_MGR_CMD FAILED: key={} command={} reason={} "
                    "(active alert blocks power-on)".format(key, command, POWER_ON_BLOCK_REASON))
                self._set_cmd_status(key, CMD_STATUS_FAILED, POWER_ON_BLOCK_REASON)
                return

        elif command not in (CMD_POWER_OFF, CMD_GRACEFUL_SHUT, CMD_POWER_CYCLE):
            self._event_log.log_warning(
                "RACK_MGR_CMD FAILED: key={} command={} reason=UNKNOWN_COMMAND".format(key, command))
            self._set_cmd_status(key, CMD_STATUS_FAILED, "UNKNOWN_COMMAND")
            return

        action_map = {
            CMD_POWER_OFF:    ACTION_POWER_OFF,
            CMD_GRACEFUL_SHUT: ACTION_GRACEFUL_SHUTDOWN,
            CMD_POWER_ON:    ACTION_POWER_ON,
            CMD_POWER_CYCLE: ACTION_POWER_CYCLE,
        }

        def on_complete(success, cmd_key=key, cmd=command):
            self._set_cmd_status(cmd_key,
                                 CMD_STATUS_DONE if success else CMD_STATUS_FAILED,
                                 "SUCCESS" if success else "ERROR")

        self.action_queue.put(ActionItem(action_map[command],
                                         "RACK_MGR_CMD:{}".format(command),
                                         on_complete))

    def _handle_chassis_module(self, key, fvs):
        """Process CHASSIS_MODULE admin_status change (admin up/down from CLI)."""
        admin_status = fvs.get(FIELD_ADMIN_STATUS, "")
        if not admin_status:
            return
        if self._last_chassis_module_admin_status.get(key) == admin_status:
            return

        self.log_notice("CHASSIS_MODULE change: key={} admin_status={}".format(key, admin_status))

        # Mirror admin_status to CHASSIS_MODULE_INFO_TABLE immediately on config change
        try:
            self.controller.update_chassis_module_admin_status(admin_status)
        except Exception as e:
            self.log_error("Failed to mirror CHASSIS_MODULE admin_status={}: {}".format(
                admin_status, repr(e)))

        if admin_status == ADMIN_DOWN:
            self.log_notice("CHASSIS_MODULE admin_down: initiating graceful shutdown of Switch-Host")
            self.action_queue.put(ActionItem(ACTION_GRACEFUL_SHUTDOWN, "CHASSIS_MODULE:ADMIN_DOWN"))

        elif admin_status == ADMIN_UP:
            if self.critical_event_checker.is_power_on_blocked():
                self._event_log.log_warning(
                    "CHASSIS_MODULE admin_up: key={} BLOCKED "
                    "({}: active alert blocks power-on)".format(key, POWER_ON_BLOCK_REASON))
            else:
                self.log_notice("CHASSIS_MODULE admin_up: powering ON Switch-Host")
                self.action_queue.put(ActionItem(ACTION_POWER_ON, "CHASSIS_MODULE:ADMIN_UP"))

        # Latch only once the request was queued or refused, so a failure before
        # this point leaves the next identical publication free to retry.
        self._last_chassis_module_admin_status[key] = admin_status

    def _leak_policy(self):
        """(policy, True), or (the defaults, False) when CONFIG_DB cannot be read: an event is never dropped."""
        try:
            return self.policy_reader.get_leak_control_policy(), True
        except Exception as e:
            self.log_error("LEAK_CONTROL_POLICY unreadable, using the defaults: {}".format(repr(e)))
            return self.policy_reader.default_leak_control_policy(), False

    def _handle_system_leak(self, key, fvs):
        """Process SYSTEM_LEAK_STATUS change from thermalctld."""
        if key != SYSTEM_LEAK_STATUS_KEY:
            return

        leak_status = fvs.get(FIELD_DEVICE_LEAK_STATUS, "")
        policy, _ = self._leak_policy()

        if policy.get("system_leak_policy") == "disabled":
            self._event_log.log_notice(
                "SYSTEM_LEAK handler done: key={} status={} result=SKIPPED (policy=disabled)".format(
                    key, leak_status))
            return

        if fvs.get(FIELD_TEST_LEAK) == "Enabled":
            # Test-injected leak: log the action that would have run, never dispatch it.
            would_be = {
                SystemLeakStatus.CRITICAL: policy.get("system_critical_leak_action",
                                                      DEFAULT_SYSTEM_CRITICAL_LEAK_ACTION),
                SystemLeakStatus.MAJOR: policy.get("system_major_leak_action",
                                                   DEFAULT_SYSTEM_MAJOR_LEAK_ACTION),
                SystemLeakStatus.MINOR: policy.get("system_minor_leak_action",
                                                   DEFAULT_SYSTEM_MINOR_LEAK_ACTION),
            }.get(leak_status, "none")
            if leak_status == SystemLeakStatus.CRITICAL and would_be == ACTION_GRACEFUL_SHUTDOWN:
                # A critical leak dispatches graceful_shutdown as power_off.
                would_be = ACTION_POWER_OFF
            self.log_notice("TEST SYSTEM LEAK (status={}); action={} not dispatched".format(
                leak_status, would_be))
            return

        if leak_status == SystemLeakStatus.CRITICAL:
            action = policy.get("system_critical_leak_action", DEFAULT_SYSTEM_CRITICAL_LEAK_ACTION)
            self._event_log.log_notice("CRITICAL SYSTEM LEAK detected (status={}); "
                                       "action={}".format(leak_status, action))
            self._dispatch_action(action, "CRITICAL_SYSTEM_LEAK", is_critical_trigger=True)

        elif leak_status == SystemLeakStatus.MAJOR:
            action = policy.get("system_major_leak_action", DEFAULT_SYSTEM_MAJOR_LEAK_ACTION)
            self._event_log.log_notice("MAJOR SYSTEM LEAK detected (status={}); "
                                       "action={}".format(leak_status, action))
            self._dispatch_action(action, "MAJOR_SYSTEM_LEAK")

        elif leak_status == SystemLeakStatus.MINOR:
            action = policy.get("system_minor_leak_action", DEFAULT_SYSTEM_MINOR_LEAK_ACTION)
            self._dispatch_action(action, "MINOR_SYSTEM_LEAK")

        else:
            self._event_log.log_notice(
                "SYSTEM_LEAK handler done: key={} status={} result=CLEARED (no action)".format(
                    key, leak_status))

    def _handle_rack_mgr_alert(self, key, fvs):
        """Process RACK_MANAGER_ALERT change from Rack Manager (via redfish docker)."""
        severity = fvs.get(FIELD_SEVERITY) or fvs.get(FIELD_LEAK, ALERT_SEVERITY_NORMAL)
        policy, policy_read = self._leak_policy()

        if policy.get("rack_mgr_leak_policy") == "disabled":
            # Log only on transition; do NOT update dedup state so that a later
            # policy re-enable + same severity re-publish still dispatches the action.
            if self._last_rack_mgr_alert_severity.get(key) != severity:
                self._event_log.log_notice(
                    "RACK_MGR_ALERT handler done: key={} severity={} result=SKIPPED (policy=disabled)".format(
                        key, severity))
            return

        if self._last_rack_mgr_alert_severity.get(key) == severity:
            return
        if policy_read:
            self._last_rack_mgr_alert_severity[key] = severity
        else:
            # Handled with the defaults: forget the key, so that the next
            # publication is handled again with the configured actions.
            self._last_rack_mgr_alert_severity.pop(key, None)

        if severity == ALERT_SEVERITY_CRITICAL:
            action = policy.get("rack_mgr_critical_alert_action", DEFAULT_RACK_MGR_CRITICAL_ALERT_ACTION)
            self._event_log.log_notice("CRITICAL RACK MGR ALERT (severity={} key={}); "
                                       "action={}".format(severity, key, action))
            self._dispatch_action(action, "RACK_MGR_CRITICAL_EVENT key={}".format(key),
                                  is_critical_trigger=True)

        elif severity == ALERT_SEVERITY_MAJOR:
            action = policy.get("rack_mgr_major_alert_action", DEFAULT_RACK_MGR_MAJOR_ALERT_ACTION)
            self._event_log.log_notice("MAJOR RACK MGR ALERT (severity={} key={}); "
                                       "action={}".format(severity, key, action))
            self._dispatch_action(action, "RACK_MGR_MAJOR_EVENT key={}".format(key))

        elif severity == ALERT_SEVERITY_MINOR:
            action = policy.get("rack_mgr_minor_alert_action", DEFAULT_RACK_MGR_MINOR_ALERT_ACTION)
            self._dispatch_action(action, "RACK_MGR_MINOR_EVENT key={}".format(key))

        else:
            self._event_log.log_notice(
                "RACK_MGR_ALERT handler done: key={} severity={} result=CLEARED (no action)".format(
                    key, severity))

    def _handle_rack_mgr_data(self, key, fvs):
        """Process a RACK_MANAGER_DATA (telemetry) change from Rack Manager.

        Telemetry is pushed periodically and is used solely to clear a previously
        raised RACK_MANAGER_ALERT: when a sensor's telemetry severity returns to
        NORMAL, the matching RACK_MANAGER_ALERT|<key> row is deleted so the
        power-on gate (has_critical_rack_mgr_alert) no longer treats it as active.
        Telemetry never raises an alert or takes a power action; per design, on
        clear no power action is taken (power-on stays under external/user control).
        """
        if key not in RACK_MGR_TELEMETRY_KEYS:
            # Telemetry only maps to the supported alert keys; ignore anything else.
            return

        # severity field for temperature/flow/pressure; leak field for rack-level leak.
        # Do not default a missing/empty field to NORMAL: a malformed telemetry row
        # must not silently clear an active alert.
        raw = fvs.get(FIELD_SEVERITY) or fvs.get(FIELD_LEAK)
        if not raw:
            return
        severity = str(raw).upper()
        if severity != ALERT_SEVERITY_NORMAL:
            # Non-NORMAL telemetry is informational only; alerts are raised via the
            # RACK_MANAGER_ALERT table, not here.
            return

        # NORMAL telemetry: clear the matching alert if one is currently active.
        tbl = swsscommon.Table(self.state_db, RACK_MANAGER_ALERT_TABLE)
        result = tbl.get(key)
        if not (result and result[0]):
            # No active alert for this key; nothing to clear (avoids per-cycle noise).
            return

        tbl._del(key)
        self._last_rack_mgr_alert_severity.pop(key, None)
        self._event_log.log_notice(
            "RACK_MGR alert CLEARED by telemetry: key={} (RACK_MANAGER_DATA severity=NORMAL)".format(key))

    # ---- dispatch helpers ----

    def _dispatch_action(self, action, event_desc, is_critical_trigger=False):
        """
        Enqueue a power action for the main thread.
        syslog_only is handled inline; all other actions go on action_queue.
        """
        self.log_notice("Event '{}' -> action '{}'".format(event_desc, action))
        if action == ACTION_SYSLOG_ONLY:
            return
        if is_critical_trigger and action == ACTION_GRACEFUL_SHUTDOWN:
            # A critical trigger must reach the power domain within the platform's
            # leak bound, so its graceful_shutdown is dispatched as a direct power-off.
            self._event_log.log_notice(
                "Event '{}' is critical: configured action '{}' is "
                "dispatched as '{}'".format(
                    event_desc, action, ACTION_POWER_OFF))
            action = ACTION_POWER_OFF
        if action in (ACTION_GRACEFUL_SHUTDOWN, ACTION_POWER_OFF, ACTION_POWER_ON):
            self.action_queue.put(ActionItem(action, event_desc))
        else:
            self.log_warning("Unknown action '{}' for event '{}'; defaulting to syslog_only".format(
                action, event_desc))

    def _set_cmd_status(self, cmd_id, status, result="SUCCESS"):
        """Update RACK_MANAGER_COMMAND entry with execution status."""
        tbl = swsscommon.Table(self.state_db, RACK_MANAGER_COMMAND_TABLE)
        fvs = swsscommon.FieldValuePairs([
            (FIELD_STATUS, status),
            (FIELD_RESULT, result),
            (FIELD_LAST_CHANGE_TIMESTAMP, get_current_timestamp()),
        ])
        tbl.set(cmd_id, fvs)


# ============================================================
# BmcctldDaemon
# ============================================================

class BmcctldDaemon(daemon_base.DaemonBase):
    """
    Main daemon class.  Performs the initial Switch-Host power-on sequence
    and then enters a blocking DB event loop.
    """

    FATAL_SIGNALS = [signal.SIGINT, signal.SIGTERM]
    NONFATAL_SIGNALS = [signal.SIGHUP]

    def __init__(self, log_identifier):
        super(BmcctldDaemon, self).__init__(log_identifier)
        self.set_min_log_priority_info()

        # Global event logger available to the daemon for critical log entries
        self._event_log = _event_logger

        self.stop_event = _StopFlag()

        # Load platform chassis (Switch-Host + BMC modules exposed here)
        try:
            import sonic_platform.platform
            self.chassis = sonic_platform.platform.Platform().get_chassis()
        except Exception as e:
            self.log_error("Failed to load platform chassis: {}".format(repr(e)))
            sys.exit(CHASSIS_LOAD_ERROR)

        self.policy_reader = PolicyReader()
        self.critical_event_checker = CriticalEventChecker(self.policy_reader)
        self.controller = SwitchHostController(self.chassis, self.critical_event_checker)
        self.graceful_shutdown = GracefulShutdownHandler(self.controller, self.policy_reader, self.stop_event)
        self.gnoi_requester_factory = GnoiRequester
        self.action_queue = ActionQueue()
        self.event_handler = BmcEventHandler(
            self.action_queue,
            self.policy_reader,
            self.critical_event_checker,
            self.stop_event,
            self.controller,
        )

        # Populate CHASSIS_MODULE_INFO_TABLE at startup with module identity and status.
        # Air-cooled boxes default to admin_status=up (no liquid-flow gate); liquid-cooled
        # boxes default to admin_status=down and require explicit admin-up to power on.
        default_admin_status = ADMIN_DOWN if self.chassis.is_liquid_cooled() else ADMIN_UP

        admin_status = self.policy_reader.get_switch_host_admin_status(default=default_admin_status)
        self.controller.initialize_chassis_module(admin_status)

        for signum in self.FATAL_SIGNALS + self.NONFATAL_SIGNALS:
            try:
                signal.signal(signum, self.signal_handler)
            except Exception as e:
                self.log_error("Cannot register signal handler for {}: {}".format(signum, e))

    # Override signal handler from DaemonBase
    def signal_handler(self, sig, frame):
        global exit_code
        if sig in self.FATAL_SIGNALS:
            exit_code = 128 + sig
            self.log_info("Caught signal '{}' ({}); exiting...".format(
                SIGNALS_TO_NAMES_DICT.get(sig, sig), exit_code))
            self.stop_event.set()
        elif sig in self.NONFATAL_SIGNALS:
            self.log_info("Caught signal '{}'; ignoring".format(SIGNALS_TO_NAMES_DICT.get(sig, sig)))
        else:
            self.log_warning("Caught unhandled signal '{}'; ignoring".format(
                SIGNALS_TO_NAMES_DICT.get(sig, sig)))

    # ---- records (main thread only) ----

    def _new_request_id(self):
        return str(uuid.uuid4())

    def _record_start(self, request_id, item):
        try:
            self.controller.write_operation_start(request_id, item.event_desc)
        except Exception as e:
            self.log_error("Failed to record operation start request_id={}: {}".format(
                request_id, repr(e)))

    def _record_terminal(self, item, request_id, op_result, op_reason, detail):
        try:
            self.controller.write_operation_terminal(
                request_id, item.event_desc, op_result, op_reason)
        except Exception as e:
            self.log_error("Failed to record operation result request_id={}: {}".format(
                request_id, repr(e)))
        self._event_log.log_notice(
            "OP_DONE action={} result={} reason={} request_id={} trigger={} detail={}".format(
                item.action, op_result, op_reason, request_id,
                item.event_desc, detail))

    def _fire(self, callback, request_id, success):
        if callback is None:
            return
        try:
            callback(success)
        except Exception:
            self.log_error("CALLBACK_FAILED request_id={}".format(request_id or "-"))

    def _finish(self, item, request_id, outcome):
        op_result, op_reason, success = outcome
        detail = POWER_ON_BLOCK_REASON if op_result == OP_RESULT_OFF_LEAK_BLOCKED else op_result
        self._record_terminal(item, request_id, op_result, op_reason, detail)
        if op_result != OP_RESULT_ABANDONED:
            # abandoned at daemon stop: a Rack Manager row stays IN_PROGRESS for the startup sweep
            self._fire(item.on_complete, request_id, success)

    # ---- guard ----

    def _guard_should_skip(self, item):
        """The live status when the request's postcondition already holds, else None.

        A removal is redundant when the host reads OFFLINE under a POWERED_OFF
        label; a power-on when it reads ONLINE. An unknown reading never skips.
        """
        try:
            current_status = self.controller.get_oper_status()
            if item.action in (ACTION_GRACEFUL_SHUTDOWN, ACTION_POWER_OFF):
                if current_status == SWITCH_HOST_OFFLINE and \
                        self.controller.get_db_power_state() == POWER_STATE_OFF:
                    return current_status
            elif item.action == ACTION_POWER_ON and current_status == SWITCH_HOST_ONLINE:
                return current_status
            return None
        except Exception as e:
            # without evidence the request runs
            self.log_error("Guard read failed for {}; running the request: {}".format(
                item.action, repr(e)))
            return None

    def _complete_guarded(self, item, live_status):
        """Finish a request the guard found already satisfied, under the guard's own reading."""
        request_id = self._start_operation(item)
        if item.action == ACTION_GRACEFUL_SHUTDOWN:
            op_result, op_reason = OP_RESULT_SUCCESS_FORCED, OP_REASON_ALREADY_OFF
        elif item.action == ACTION_POWER_OFF:
            op_result, op_reason = OP_RESULT_SUCCESS, OP_REASON_ALREADY_OFF
        else:
            op_result, op_reason = OP_RESULT_SUCCESS, "-"
        stable_state = POWER_STATE_ON if item.action == ACTION_POWER_ON else POWER_STATE_OFF
        # Settle the label under the guard's own reading: a stale transitional
        # label becomes the settled one; a settled label (POWER_CYCLE included) is kept.
        try:
            db_power_state = self.controller.get_db_power_state()
            label = (db_power_state if db_power_state in SETTLED_LABELS[stable_state]
                     else stable_state)
            self.controller._write_label(label, live_status, "settled record")
        except Exception as e:
            self.log_error("Failed to settle the Switch-Host record after a guard skip: {}".format(
                repr(e)))
        self._record_terminal(
            item, request_id, op_result, op_reason, GUARD_SKIP_DETAIL)
        self._fire(item.on_complete, request_id, True)

    # ---- outcomes ----

    def _plain_outcome(self, action, result):
        if result == PowerCallResult.CONFIRMED:
            return OP_RESULT_SUCCESS, "-", True
        if result == PowerCallResult.CANCELLED:
            return OP_RESULT_PREEMPTED, OP_REASON_PREEMPTED, False
        if result == PowerCallResult.REFUSED_LEAK:
            return OP_RESULT_OFF_LEAK_BLOCKED, "-", False
        if action == ACTION_POWER_OFF:
            return OP_RESULT_POWER_OFF_FAILED, "-", False
        return OP_RESULT_POWER_ON_FAILED, "-", False

    def _failure_outcome(self, operation):
        """Record of an operation whose own code raised; no power call is repeated.

        A daemon stop abandons, a cancellation is a preemption, otherwise the
        phase that was running failed.
        """
        if self.stop_event.is_set():
            return OP_RESULT_ABANDONED, "-", False
        if operation.cancel.is_set():
            return OP_RESULT_PREEMPTED, operation.leg_reason or OP_REASON_PREEMPTED, False
        failed = (OP_RESULT_POWER_ON_FAILED if operation.phase == PHASE_RAISING
                  else OP_RESULT_POWER_OFF_FAILED)
        if operation.item.action == ACTION_GRACEFUL_SHUTDOWN:
            return failed, operation.leg_reason or OP_REASON_UNCLASSIFIED, False
        return failed, "-", False

    # ---- dispatch ----

    def _make_operation(self, item, request_id):
        operation = Operation(item, request_id, None)
        # a power-off yields to nothing but the stop; everything else to what outranks its phase
        operation.cancel = self.stop_event if item.action == ACTION_POWER_OFF else _OpCancel(self, operation)
        return operation

    def _start_operation(self, item):
        """Give a dequeued request its id and open its records."""
        request_id = self._new_request_id()
        self._record_start(request_id, item)
        self._event_log.log_notice(
            "OP_START action={} request_id={} trigger={}".format(
                item.action, request_id, item.event_desc))
        return request_id

    def _dispatch(self, item):
        """Common entry for every dequeued request."""
        if item.action not in QUEUE_ACTIONS:
            # refused before any record is opened
            self.log_warning("Unknown action '{}' in queue; skipping".format(item.action))
            self._fire(item.on_complete, "-", False)
            return
        if item.startup:
            try:
                admin_status = self.policy_reader.get_switch_host_admin_status()
                removal_first = self._rm_removal_recorded()
            except Exception as e:
                # An automatic raise whose preconditions cannot be read is not taken.
                self._event_log.log_notice(
                    "STARTUP power_on dropped: its preconditions could not be read ({})".format(
                        repr(e)))
                return
            if admin_status != ADMIN_UP:
                self._event_log.log_notice(
                    "STARTUP power_on dropped: admin_status='{}'".format(admin_status))
                return
            if removal_first:
                self._event_log.log_notice(
                    "STARTUP power_on dropped: a Rack Manager power removal is recorded")
                return

        live_status = self._guard_should_skip(item)
        if live_status is not None:
            self._complete_guarded(item, live_status)
            return
        self._run_operation(item)

    def _run_operation(self, item):
        """Run one dequeued request on the main thread and write its records."""
        request_id = self._start_operation(item)
        operation = self._make_operation(item, request_id)
        try:
            if item.action == ACTION_POWER_OFF:
                result = self.controller.power_off(operation.cancel)
                outcome = self._plain_outcome(item.action, result)
            elif item.action == ACTION_POWER_ON:
                result = self.controller.power_on(operation.cancel)
                outcome = self._plain_outcome(item.action, result)
            elif item.action == ACTION_POWER_CYCLE:
                result = self.controller.power_cycle(operation.cancel)
                outcome = self._plain_outcome(item.action, result)
            elif item.action == ACTION_GRACEFUL_SHUTDOWN:
                outcome = self.graceful_shutdown.execute(operation, self.gnoi_requester_factory)
            else:
                raise ValueError("unsupported action '{}'".format(item.action))
        except Exception as e:
            self.log_error(
                "Operation failed action={} request_id={} phase={}: {}\n{}".format(
                    item.action, request_id, operation.phase, repr(e),
                    traceback.format_exc()))
            outcome = self._failure_outcome(operation)
        if outcome[0] == OP_RESULT_PREEMPTED and self.stop_event.is_set():
            outcome = (OP_RESULT_ABANDONED, "-", False)
        self._finish(item, request_id, outcome)

    # ---- startup ----

    def _rm_rows(self):
        """(key, fields) for every Rack Manager command row."""
        tbl = swsscommon.Table(self.event_handler.state_db, RACK_MANAGER_COMMAND_TABLE)
        for key in tbl.getKeys():
            result = tbl.get(key)
            if result and result[0]:
                yield key, fvs_to_dict(result[1])

    def _rm_removal_recorded(self):
        """True when a Rack Manager power-off or graceful shutdown row is recorded.

        DONE or abandoned keeps the automatic power-on off across BMC restarts;
        PENDING, no status or IN_PROGRESS means that removal is about to run. A removal
        that failed otherwise does not count.
        """
        for key, entry in self._rm_rows():
            if entry.get(FIELD_COMMAND, "") not in (CMD_POWER_OFF, CMD_GRACEFUL_SHUT):
                continue
            status = entry.get(FIELD_STATUS, "")
            if status in (CMD_STATUS_PENDING, "", CMD_STATUS_IN_PROGRESS, CMD_STATUS_DONE):
                return True
            if status == CMD_STATUS_FAILED and entry.get(FIELD_RESULT, "") == OP_RESULT_ABANDONED:
                return True
        return False

    def _sweep_stale_rm_rows(self):
        """Close Rack Manager rows left IN_PROGRESS by a previous run (before the event thread starts)."""
        for key, entry in self._rm_rows():
            if entry.get(FIELD_STATUS, "") != CMD_STATUS_IN_PROGRESS:
                continue
            self._event_log.log_warning(
                "STARTUP: Rack Manager command {} ({}) left IN_PROGRESS by a previous run; "
                "marking FAILED/{}".format(key, entry.get(FIELD_COMMAND, "-"), OP_RESULT_ABANDONED))
            self.event_handler._set_cmd_status(key, CMD_STATUS_FAILED, OP_RESULT_ABANDONED)

    def _enqueue_startup_power_on(self):
        """Queue the automatic power-on; its dispatch re-checks admin_status, removals and the gate."""
        oper_status = self.controller.get_oper_status()
        self.log_info("STARTUP: Switch-Host oper_status={}".format(oper_status))
        if oper_status == SWITCH_HOST_ONLINE:
            self._event_log.log_notice("STARTUP: Switch-Host already ONLINE; refreshing HOST_STATE")
            self.controller.init_host_state()
            return
        # The daemon admits its own request through the same gate as any other.
        if self.critical_event_checker.is_power_on_blocked():
            self._event_log.log_warning(
                "STARTUP: Switch-Host power_on BLOCKED ({}: active alert blocks power-on)".format(
                    POWER_ON_BLOCK_REASON))
            return
        self._event_log.log_notice("STARTUP: Switch-Host OFFLINE — issuing power_on")
        self.action_queue.put(ActionItem(ACTION_POWER_ON, "STARTUP", startup=True))

    def _initial_power_on_sequence(self):
        """
        BMC startup flow
          1. Check CHASSIS_MODULE admin_status for SWITCH-HOST. If 'down' (the default),
             Switch-Host stays powered off — exit immediately. The operator must run
             'config chassis modules startup SWITCH-HOST' to bring it up.
          2. Sleep SWITCH_HOST_POWER_ON_DELAY seconds to allow Rack Manager to come
             up and verify liquid flow (liquid-cooled) or simply stabilise (air-cooled).
             While sleeping, keep draining the action_queue so Rack Manager commands
             (e.g. POWER_OFF) arriving during the delay are acted on immediately.
          3. After the delay, queue the automatic power-on. Its dispatch drops it
             when admin_status is no longer up or a Rack Manager power removal is
             recorded; the gate and the guard apply as for any request.
        """
        admin_status = self.policy_reader.get_switch_host_admin_status()
        if admin_status != ADMIN_UP:
            self._event_log.log_notice("STARTUP: SWITCH-HOST admin_status='{}' (default=down); "
                                       "Switch-Host will remain powered off. "
                                       "Run 'config chassis modules startup SWITCH-HOST' to power on.".format(admin_status))
            return

        # Only apply the boot delay on a cold boot (FULL POWER LOSS). On warm/fast/soft
        # reboots, the Switch-Host is expected to come back quickly and Rack Manager/
        # liquid flow has already been verified, so the delay is unnecessary.
        boot_delay = 0
        try:
            reboot_cause, _ = self.chassis.get_reboot_cause()
        except Exception as e:
            self.log_warning("STARTUP: get_reboot_cause() failed: {}; assuming cold boot".format(repr(e)))
            reboot_cause = ChassisBase.REBOOT_CAUSE_POWER_LOSS

        if reboot_cause == ChassisBase.REBOOT_CAUSE_POWER_LOSS:
            boot_delay = self.policy_reader.get_power_on_delay()
            # Use system uptime so that a bmcctld restart mid-boot (or any later restart)
            # doesn't re-arm the full SWITCH_HOST_POWER_ON_DELAY.  We only need to wait
            # for any time remaining relative to system uptime, not start a fresh timer.
            # CLOCK_BOOTTIME is monotonic and includes any suspend time.
            try:
                system_uptime = time.clock_gettime(time.CLOCK_BOOTTIME)
            except Exception as e:
                self.log_warning("STARTUP: failed to read CLOCK_BOOTTIME ({}); "
                                 "assuming uptime=0".format(repr(e)))
                system_uptime = 0
            boot_delay = max(0, int(boot_delay - system_uptime))
            if boot_delay > 0:
                self.log_notice("Waiting {}s before initial Switch-Host power-on check "
                                "(SWITCH_HOST_POWER_ON_DELAY, uptime={:.1f}s, reboot_cause={})".format(
                                    boot_delay, system_uptime, reboot_cause))
            else:
                self.log_notice("Skipping SWITCH_HOST_POWER_ON_DELAY: "
                                "system uptime ({:.1f}s) already exceeds power_on_delay".format(system_uptime))
        else:
            self.log_notice("Skipping SWITCH_HOST_POWER_ON_DELAY (reboot_cause={}, not a full power loss)".format(reboot_cause))

        # Drain the action queue while we wait so Rack Manager / admin commands
        # received during the boot delay are processed in real time. Use a
        # monotonic clock so an NTP step during boot can't extend the wait.
        deadline = time.monotonic() + boot_delay
        while True:
            remaining = deadline - time.monotonic()
            if remaining <= 0 or self.stop_event.is_set():
                break
            item = self.action_queue.get(timeout=min(1.0, remaining))
            if item is not None:
                self._execute_action_item(item)
        if self.stop_event.is_set():
            return

        self._enqueue_startup_power_on()

    def _execute_action_item(self, item):
        """
        Execute a single ActionItem on the main thread.
        Calls item.on_complete(success) when finished if a callback was provided.
        A failure outside the operation never ends the daemon; the requester is told.
        """
        try:
            self._dispatch(item)
        except Exception as e:
            self.log_error("Dispatch failed action={} trigger={}: {}\n{}".format(
                item.action, item.event_desc, repr(e), traceback.format_exc()))
            self._fire(item.on_complete, "-", False)

    def _run_action_loop(self):
        """
        Main thread action processor.  Dequeues and executes ActionItems
        sequentially until stop_event is set.  Actions are serialised naturally
        by this single consumer — no extra locking needed.
        """
        self.log_info("Entering action processing loop")
        while not self.stop_event.is_set():
            item = self.action_queue.get(timeout=1.0)
            if item is not None:
                self._execute_action_item(item)

    def _drain_on_stop(self):
        """Log every request still queued at stop; none of them started.

        A Rack Manager row stays IN_PROGRESS; the startup sweep closes it as abandoned.
        """
        for item in self.action_queue.drain():
            self._event_log.log_notice(
                "Request abandoned at daemon stop: action={} trigger={} (not started)".format(
                    item.action, item.event_desc))

    def run(self):
        """
        Called once by the main loop.  Startup flow:

          1. Sync HOST_STATE from live oper_status and seed CONFIG dedup state.
             Close Rack Manager rows a previous run left IN_PROGRESS.
          2. Start the BmcEventHandler thread (CLI admin up/down, Rack Manager, leaks).
          3. If Switch-Host is already ONLINE: skip boot power-on sequence.
          4. Non-liquid-cooled + OFFLINE + admin_status=up: power on immediately.
          5. Liquid-cooled + OFFLINE: run _initial_power_on_sequence (boot delay).
          6. Enter the action processing loop.

        HOST_STATE sync and CONFIG dedup (step 1) run before the event thread so
        SubscriberStateTable replays are treated as already handled and do not
        enqueue ACTION_POWER_ON ahead of action-loop readiness. The BmcEventHandler
        thread (step 2) is started before the boot sequence so CLI admin commands
        and other CONFIG/STATE events are captured regardless of the startup path.
        startup power-on or the action loop.

        Returns False to terminate the outer while-loop.
        """
        self._event_log.log_notice("bmcctld starting up")

        # Publish HOST_STATE and seed CONFIG dedup before SubscriberStateTable
        # replays can enqueue ACTION_POWER_ON before the action loop is ready.
        self.controller.init_host_state()
        self.event_handler.seed_chassis_module_admin_status()
        self._sweep_stale_rm_rows()

        # Start the event thread — it handles CLI admin up/down commands
        # (CHASSIS_MODULE admin_status) regardless of cooling type.
        event_thread = threading.Thread(
            target=self.event_handler.run_event_loop,
            daemon=True,
            name="bmcctld-events",
        )
        event_thread.start()
        try:
            return self._startup_then_action_loop()
        finally:
            try:
                self.deinit()
            finally:
                event_thread.join(timeout=STOP_JOIN_SECS)
                self._drain_on_stop()

    def _startup_then_action_loop(self):
        """The part of run() that runs while the event thread is alive."""
        # If Switch-Host is already ONLINE (daemon restart), skip the boot
        # sequence entirely and go straight to the action loop.
        if self.controller.get_oper_status() == SWITCH_HOST_ONLINE:
            self._event_log.log_notice("STARTUP: Switch-Host already ONLINE (daemon restart); "
                                       "skipping boot sequence")
        elif not self.chassis.is_liquid_cooled():
            admin_status = self.policy_reader.get_switch_host_admin_status()
            if admin_status != ADMIN_UP:
                self._event_log.log_notice(
                    "STARTUP: SWITCH-HOST admin_status='{}'; "
                    "Switch-Host will remain powered off. "
                    "Run 'config chassis modules startup SWITCH-HOST' to power on.".format(
                        admin_status))
            else:
                self._event_log.log_notice("STARTUP: non-liquid-cooled system — "
                                           "queueing power_on")
                self._enqueue_startup_power_on()
        else:
            # Liquid-cooled: wait for Rack Manager to verify liquid flow, check for
            # leaks/alerts, then power on if safe.
            self._initial_power_on_sequence()
            if self.stop_event.is_set():
                return False

        self._run_action_loop()
        return False

    def deinit(self):
        self.log_notice("bmcctld shutting down")
        self.stop_event.set()
        self.action_queue.notify_all()


# ============================================================
# Main
# ============================================================

def main():
    daemon = BmcctldDaemon(SYSLOG_IDENTIFIER)
    daemon.log_info("Starting up...")

    while daemon.run():
        pass

    daemon.log_info("Shutting down with exit code {}...".format(exit_code))
    return exit_code


if __name__ == "__main__":
    sys.exit(main())
