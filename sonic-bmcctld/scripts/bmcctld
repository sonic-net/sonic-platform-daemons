# This class could be moved to sonic-py-common, the log file name can be passed as input.
class EventLogger(logger.Logger):
    """
    Extends sonic_py_common Logger to optionally tee log calls to a local file
    in addition to syslog.  A file is used only for critical power/leak/alert
    events, which must survive syslog rotation and be easy to grep offline.

    When log_file is None the instance logs to syslog only.  Container-local
    files are not rotated by the host logrotate, so a file target must live on
    a host-visible path that logrotate covers.
    """

    def __init__(self, syslog_identifier, log_file=None):
        super(EventLogger, self).__init__(syslog_identifier)
        # Derive a unique Python logger name per log file so instances writing
        # to different files do not share handlers.  Syslog-only instances
        # share a single inert logger.
        py_name = "{}.{}".format(
            syslog_identifier,
            os.path.basename(log_file).replace(".", "_") if log_file else "syslog_only")
        self._file_logger = logging.getLogger(py_name)
        if log_file is None:
            # Keep the logger inert so records are neither emitted nor
            # propagated to the root logger.
            self._file_logger.propagate = False
            if not self._file_logger.handlers:
                self._file_logger.addHandler(logging.NullHandler())
            return
        if not self._file_logger.handlers and os.getenv("BMCCTLD_UNIT_TESTING") != "1":
            try:
                handler = logging.FileHandler(log_file)
                handler.setFormatter(logging.Formatter(
                    "%(asctime)s %(name)s[%(process)d] %(levelname)s: %(message)s",
                    datefmt="%Y-%m-%dT%H:%M:%S",
                ))
                self._file_logger.addHandler(handler)
                self._file_logger.setLevel(logging.DEBUG)
            except (OSError, IOError) as e:
                self.log_error(
                    "EventLogger: failed to open log file {} ({}); events will go to syslog only".format(
                        log_file, repr(e)))

    def log_debug(self, msg, also_print_to_console=False):
        super(EventLogger, self).log_debug(msg, also_print_to_console)
        self._file_logger.debug(msg)

    def log_info(self, msg, also_print_to_console=False):
        super(EventLogger, self).log_info(msg, also_print_to_console)
        self._file_logger.info(msg)

    def log_notice(self, msg, also_print_to_console=False):
        super(EventLogger, self).log_notice(msg, also_print_to_console)
        self._file_logger.info("NOTICE: " + msg)

    def log_warning(self, msg, also_print_to_console=False):
        super(EventLogger, self).log_warning(msg, also_print_to_console)
        self._file_logger.warning(msg)

    def log_error(self, msg, also_print_to_console=False):
        super(EventLogger, self).log_error(msg, also_print_to_console)
        self._file_logger.error(msg)


class ActionItem:
    """
    Carries a power action from the BmcEventHandler thread to the
    BmcctldDaemon main thread action loop.

    on_complete(success: bool) is called by the main thread after the
    action finishes — used by Rack Manager command handlers to write the
    final CMD_STATUS_DONE / CMD_STATUS_FAILED back to STATE_DB. It is not
    called for a request that the daemon stop abandoned.
    startup marks the automatic power-on.
    """
    def __init__(self, action, event_desc, on_complete=None, startup=False):
        self.action = action
        self.event_desc = event_desc
        self.on_complete = on_complete
        self.startup = startup


class Operation:
    """Mutable state of one running power operation."""

    def __init__(self, item, request_id, cancel):
        self.item = item
        self.request_id = request_id
        self.cancel = cancel        # the daemon stop flag for a power-off, else an _OpCancel view of this operation
        self.phase = PHASE_RAISING if item.action in (ACTION_POWER_ON, ACTION_POWER_CYCLE) else PHASE_REMOVING
        self.leg_reason = None      # "-" after a graceful leg, else the forced leg's reason
        self.leg = None             # (graceful, reason) from the handshake thread
        self.abandoned = False      # the main thread stopped waiting for the handshake thread
        self.requester = None


class PowerCallResult(Enum):
    CONFIRMED = "confirmed"
    NOT_CONFIRMED = "not_confirmed"
    CANCELLED = "cancelled"
    REFUSED_LEAK = "refused_leak"


